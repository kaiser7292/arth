<manifest xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools">
  <!--
    The Prompt API needs Android 8 (API 26); Arth still installs on Android 7 (API 24). Allow the
    merge, and the module never touches the library below API 26 (see ArthNanoModule.supported).
  -->
  <uses-sdk tools:overrideLibrary="com.google.mlkit.genai.prompt,com.google.mlkit.genai.common" />
</manifest>
