{
  "expo": {
    "name": "Arth",
    "slug": "artha",
    "version": "4.27.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "artha",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "android": {
      "package": "com.souravbaid.arth",
      "versionCode": 42700,
      "adaptiveIcon": {
        "backgroundColor": "#134E4A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.READ_SMS",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.USE_EXACT_ALARM",
        "android.permission.BIND_NOTIFICATION_LISTENER_SERVICE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "allowBackup": false,
      "softwareKeyboardLayoutMode": "resize",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "autoVerify": false,
          "action": "VIEW",
          "data": [
            {
              "scheme": "artha",
              "host": "kite-callback"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "category": [
            "DEFAULT",
            "BROWSABLE"
          ],
          "data": [
            {
              "scheme": "content"
            },
            {
              "scheme": "file"
            },
            {
              "host": "*"
            },
            {
              "mimeType": "*/*"
            },
            {
              "pathPattern": ".*\\\\.arth"
            },
            {
              "pathPattern": ".*\\\\..*\\\\.arth"
            },
            {
              "pathPattern": ".*\\\\..*\\\\..*\\\\.arth"
            },
            {
              "pathPattern": ".*\\\\..*\\\\..*\\\\..*\\\\.arth"
            },
            {
              "pathPattern": ".*\\\\..*\\\\..*\\\\..*\\\\..*\\\\.arth"
            },
            {
              "pathPattern": ".*\\\\.artha"
            },
            {
              "pathPattern": ".*\\\\..*\\\\.artha"
            },
            {
              "pathPattern": ".*\\\\..*\\\\..*\\\\.artha"
            },
            {
              "pathPattern": ".*\\\\..*\\\\..*\\\\..*\\\\.artha"
            },
            {
              "pathPattern": ".*\\\\..*\\\\..*\\\\..*\\\\..*\\\\.artha"
            }
          ]
        },
        {
          "action": "VIEW",
          "category": [
            "DEFAULT",
            "BROWSABLE"
          ],
          "data": [
            {
              "scheme": "content"
            },
            {
              "scheme": "file"
            },
            {
              "mimeType": "application/octet-stream"
            }
          ]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "./plugins/withIosBuildFixes",
      "./plugins/withDisableBackup",
      "./plugins/withArmOnly",
      "./plugins/withAapt2Fix",
      "./plugins/withLargeHeap",
      "./plugins/withOptionalHardware",
      "./plugins/withBankMessageIntent",
      "./plugins/withReleaseSigning",
      "./plugins/withR8",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "ArthCatchUp",
              "label": "Arth Catch Up",
              "description": "What's waiting to review, with Add and Voice buttons",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "ArthSummary",
              "label": "Arth this month",
              "description": "Budget left against the pace of the month, with quick add",
              "minWidth": "180dp",
              "minHeight": "40dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "ArthReview",
              "label": "Arth review",
              "description": "Approve or reject new transactions, and see payments due soon",
              "minWidth": "250dp",
              "minHeight": "250dp",
              "targetCellWidth": 4,
              "targetCellHeight": 4,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 300,
          "resizeMode": "contain",
          "backgroundColor": "#134E4A",
          "dark": {
            "backgroundColor": "#111111"
          }
        }
      ],
      "expo-sqlite",
      "expo-notifications",
      [
        "expo-calendar",
        {
          "calendarPermission": "Arth adds your upcoming bills, EMIs and reminders to the calendar you choose."
        }
      ],
      "expo-speech-recognition",
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              {
                "fontFamily": "Inter",
                "fontDefinitions": [
                  {
                    "path": "node_modules/@expo-google-fonts/inter/400Regular/Inter_400Regular.ttf",
                    "weight": 400
                  },
                  {
                    "path": "node_modules/@expo-google-fonts/inter/500Medium/Inter_500Medium.ttf",
                    "weight": 500
                  },
                  {
                    "path": "node_modules/@expo-google-fonts/inter/600SemiBold/Inter_600SemiBold.ttf",
                    "weight": 600
                  },
                  {
                    "path": "node_modules/@expo-google-fonts/inter/700Bold/Inter_700Bold.ttf",
                    "weight": 700
                  }
                ]
              }
            ]
          },
          "ios": {
            "fonts": [
              "node_modules/@expo-google-fonts/inter/400Regular/Inter_400Regular.ttf",
              "node_modules/@expo-google-fonts/inter/500Medium/Inter_500Medium.ttf",
              "node_modules/@expo-google-fonts/inter/600SemiBold/Inter_600SemiBold.ttf",
              "node_modules/@expo-google-fonts/inter/700Bold/Inter_700Bold.ttf"
            ]
          }
        }
      ],
      "./plugins/withShareTarget",
      [
        "expo-share-intent",
        {
          "androidIntentFilters": [
            "image/*",
            "text/*"
          ],
          "iosActivationRules": {
            "NSExtensionActivationSupportsImageWithMaxCount": 1,
            "NSExtensionActivationSupportsText": true
          },
          "iosShareExtensionName": "ArthShare",
          "iosShareExtensionDisplayName": "Arth"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Arth reads a payment screenshot you choose, on this phone, to fill in a transaction.",
          "cameraPermission": "Arth uses the camera only when you take a photo of a payment or receipt, to read it on this phone.",
          "microphonePermission": "Arth uses the microphone only while you add a transaction or search by voice."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "86f29bcf-403b-4a81-9931-107c6a6a266e"
      }
    },
    "owner": "kaiser7292",
    "ios": {
      "bundleIdentifier": "com.souravbaid.arth",
      "buildNumber": "5",
      "supportsTablet": false,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Arth reads a payment screenshot you choose, on this phone, to fill in a transaction.",
        "NSFaceIDUsageDescription": "Arth uses Face ID to lock the app.",
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "Arth backup",
            "LSHandlerRank": "Owner",
            "LSItemContentTypes": [
              "com.souravbaid.arth.backup"
            ]
          }
        ],
        "UTExportedTypeDeclarations": [
          {
            "UTTypeIdentifier": "com.souravbaid.arth.backup",
            "UTTypeDescription": "Arth backup",
            "UTTypeConformsTo": [
              "public.data"
            ],
            "UTTypeTagSpecification": {
              "public.filename-extension": [
                "arth",
                "artha"
              ]
            }
          }
        ],
        "LSSupportsOpeningDocumentsInPlace": false
      }
    }
  }
}
